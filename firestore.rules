rules_version = '2';

/* Anonymous authentication is not a security boundary.
 *
 * Anyone can mint an anonymous uid — it is a device identifier, not a person,
 * and it costs an attacker one HTTP request. So request.auth != null means
 * "this write came from something that bothered to get a token", nothing more.
 * Every rule below assumes the caller is hostile and the client is a lie:
 * shape, ranges and ownership are all checked here, because the checks in
 * spatial/store.js are for catching mistakes, not for stopping anyone.
 *
 * What this does NOT solve is volume. Rules cannot rate-limit, and an
 * anonymous uid is free, so a determined nuisance can fill the collection.
 * Turn on App Check (Play Integrity / reCAPTCHA Enterprise) before this is
 * public — that is the control that actually costs an attacker something.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /placements/{placement} {

      // ── development ────────────────────────────────────────────
      // Delete this block, and every isDeveloper() below it, before anyone
      // else uses this.
      //
      // It exists because clearing the collection between tests is otherwise a
      // trip to the Firebase console, and a test run that cannot start from
      // nothing is a test run whose result means very little. It is a named
      // uid rather than "any signed-in caller" so that the hole is exactly one
      // device wide and obvious in a diff.
      //
      // Paste the uid the app shows on its Uid line. It is stable across
      // launches now that the refresh token is kept; before that it was a
      // different uid every launch, which is why deleting your own placements
      // never once worked.

      allow read: if resource.data.visibility == 'public'
                  || (request.auth != null && request.auth.uid == resource.data.owner);

      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && isWellFormed(request.resource.data)
                    && request.resource.data.createdAt is string;

      // The owner may move or retire their own placement, but never hand it to
      // someone else, and never edit its geohash out of step with its position.
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == resource.data.owner
                    && isWellFormed(request.resource.data);

      allow delete: if request.auth != null
                    && (resource.data.owner == request.auth.uid || isDeveloper());
    }

    // Anything not named above is closed. Collections get rules deliberately
    // or they get nothing.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // ── development ──────────────────────────────────────────────
  // Remove along with the note above. An empty string matches nobody, so the
  // rules are safe to deploy before the uid is filled in.
  function isDeveloper() {
    return request.auth.uid == '';
  }

  function isWellFormed(data) {
    return data.keys().hasOnly([
             'geopose', 'geohash', 'scene', 'scale', 'fix', 'groundOffset',
             'label', 'visibility', 'owner', 'createdAt'
           ])
           && data.keys().hasAll(['geopose', 'geohash', 'scene', 'scale', 'visibility', 'owner'])
           && isGeoPose(data.geopose)
           && data.geohash is string
           && data.geohash.size() >= 4 && data.geohash.size() <= 12
           && data.scene is string
           && data.scene.size() > 0 && data.scene.size() <= 64
           && data.scale is number
           && data.scale > 0 && data.scale <= 1000
           && data.visibility in ['public', 'private']
           && data.groundOffset is number
           && data.groundOffset >= -100 && data.groundOffset <= 100
           // A display name is a courtesy, not an identity — nothing verifies
           // it — so the only thing worth enforcing is that it cannot be used
           // as free storage.
           && data.label is string
           && data.label.size() <= 40;
  }

  function isGeoPose(pose) {
    return pose.keys().hasOnly(['position', 'quaternion'])
           && pose.position.lat is number
           && pose.position.lat >= -90 && pose.position.lat <= 90
           && pose.position.lon is number
           && pose.position.lon >= -180 && pose.position.lon <= 180
           && pose.position.h is number
           // Below the Dead Sea or above the stratosphere is a bug, not a place.
           && pose.position.h >= -500 && pose.position.h <= 20000
           && pose.quaternion.x is number && pose.quaternion.y is number
           && pose.quaternion.z is number && pose.quaternion.w is number;
  }
}
