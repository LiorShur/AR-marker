rules_version = '2';

/* Anonymous authentication is not a security boundary.
 *
 * Anyone can mint an anonymous uid — it is a device identifier, not a person,
 * and it costs an attacker one HTTP request. So request.auth != null means
 * "this write came from something that bothered to get a token", nothing more.
 * Every rule below assumes the caller is hostile and the client is a lie:
 * shape, ranges and ownership are all checked here, because the checks in
 * spatial/store.js are for catching mistakes, not for stopping anyone.
 *
 * What this does NOT solve is volume. Rules cannot rate-limit, and an
 * anonymous uid is free, so a determined nuisance can fill the collection.
 * Turn on App Check (Play Integrity / reCAPTCHA Enterprise) before this is
 * public — that is the control that actually costs an attacker something.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /placements/{placement} {

      allow read: if resource.data.visibility == 'public'
                  || (request.auth != null && request.auth.uid == resource.data.owner);

      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && isWellFormed(request.resource.data)
                    && request.resource.data.createdAt is string;

      // The owner may move or retire their own placement, but never hand it to
      // someone else, and never edit its geohash out of step with its position.
      //
      // The second branch is for map seeds. A placement dropped from a map is
      // owned by whoever ran the script — in practice an anonymous identity
      // that existed for one write and will never be seen again — and is
      // accurate to whatever the satellite imagery was worth. It is a note
      // saying "something belongs about here", and the only person who can
      // improve it is somebody standing in front of the actual thing.
      //
      // So the first person to correct one takes it. That is deliberately open:
      // anyone signed in can claim any unclaimed seed, and the protection is
      // that they can only claim it by replacing its coordinates with theirs,
      // once, after which it is an ordinary owned placement. Seeds are meant to
      // be claimed; a seed nobody may touch is just a permanently wrong
      // placement.
      allow update: if request.auth != null
                    && isWellFormed(request.resource.data)
                    && (
                         (resource.data.owner == request.auth.uid
                          && request.resource.data.owner == resource.data.owner)
                         ||
                         (resource.data.fix.provider == 'map'
                          && request.resource.data.owner == request.auth.uid
                          && request.resource.data.scene == resource.data.scene
                          && request.resource.data.fix.provider != 'map')
                       );

      allow delete: if request.auth != null
                    && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Anything not named above is closed. Collections get rules deliberately
    // or they get nothing.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  /* Who may remove somebody else's placement.
   *
   * By verified email rather than by uid. A uid is sixteen unreadable
   * characters that have to be read off a device and pasted in here, and it
   * changes the moment its owner signs in with an account — so a list written
   * before accounts existed silently stops matching anybody, and the failure
   * looks like a broken button rather than a stale list.
   *
   * email_verified is the whole of the security here, and it is not a detail.
   * Anyone can register an account claiming any address they like; what they
   * cannot do is receive the mail sent to it. Google and Apple sign-ins arrive
   * verified. A password account arrives unverified until its owner follows
   * the link, so an admin listed here who registered with a password and never
   * confirmed it will be refused — correctly.
   *
   * Which is why there is a uid branch as well. A uid is unforgeable and needs
   * no verification, so it is the one that always works — at the cost of having
   * to be read off the device and pasted in, and of going stale if its owner
   * ever registers again. Use the email list; keep the uid as the way back in
   * when the email list is the thing that is wrong.
   *
   * Empty lists match nobody, which is the right default: this erases a shared
   * world.
   */
  function isAdmin() {
    return request.auth.uid in [
             'xleQV9Ac88YQQSomu7E2AoPjryF2'
           ]
           || (request.auth.token.get('email_verified', false) == true
               && request.auth.token.get('email', '') in [
                    'liorshur@gmail.com',
                    'lior.shur@gmail.com'
                  ]);
  }

  function isWellFormed(data) {
    return data.keys().hasOnly([
             'geopose', 'geohash', 'scene', 'scale', 'fix', 'groundOffset',
             'label', 'author', 'visibility', 'owner', 'createdAt',
             'parent', 'local', 'venue', 'at', 'marker'
           ])
           && data.keys().hasAll(['geopose', 'geohash', 'scene', 'scale', 'visibility', 'owner'])
           && isGeoPose(data.geopose)
           && data.geohash is string
           && data.geohash.size() >= 4 && data.geohash.size() <= 12
           && data.scene is string
           && data.scene.size() > 0 && data.scene.size() <= 64
           && data.scale is number
           && data.scale > 0 && data.scale <= 1000
           && data.visibility in ['public', 'private']
           && data.groundOffset is number
           && data.groundOffset >= -100 && data.groundOffset <= 100
           // A display name is a courtesy, not an identity — nothing verifies
           // it — so the only thing worth enforcing is that it cannot be used
           // as free storage.
           && data.label is string
           && data.label.size() <= 40
           // Who to credit, as opposed to owner, which is who may edit. Also a
           // courtesy and also unverified — nothing stops somebody claiming to
           // be anyone — so the only thing worth enforcing is the same: that it
           // cannot be used as free storage.
           && (!('author' in data.keys()) ||
               (data.author is string && data.author.size() <= 40))
           && isLinked(data)
           && isInVenue(data);
  }

  /* Somewhere indoors, pinned by a printed marker rather than by the Earth.
   *
   * Both fields or neither, for the same reason as a linked placement: a venue
   * with no pose has no idea where in it the thing is, and a pose with no venue
   * has no frame to be a pose in.
   *
   * A kilometre is a campus rather than a venue, and past that the drift
   * accumulated walking between two markers is larger than anything being
   * placed — so the bound is a statement about what this can actually do, not
   * only about storage.
   *
   * A marker is an ordinary placement that a camera can also find. Nothing here
   * distinguishes the organizer's markers from anyone else's, because nothing
   * needs to: a marker somebody else adds to a venue is a marker that only
   * resolves for whoever can also see the printed image.
   */
  function isInVenue(data) {
    return (!('venue' in data.keys()) && !('at' in data.keys())
            && !('marker' in data.keys()))
           || (data.venue is string
               && data.venue.size() > 0 && data.venue.size() <= 64
               && data.at.keys().hasOnly(['x', 'y', 'z', 'rotation'])
               && data.at.x is number && data.at.x >= -1000 && data.at.x <= 1000
               && data.at.y is number && data.at.y >= -1000 && data.at.y <= 1000
               && data.at.z is number && data.at.z >= -1000 && data.at.z <= 1000
               && data.at.rotation.x is number && data.at.rotation.y is number
               && data.at.rotation.z is number && data.at.rotation.w is number
               && (!('marker' in data.keys()) ||
                   (data.marker is string
                    && data.marker.size() > 0 && data.marker.size() <= 64)));
  }

  /* A piece of something larger, rather than a thing on its own.
   *
   * Both fields or neither: a parent with no offset has no idea where it sits,
   * and an offset with no parent has nothing to be measured from. Either is a
   * document the client cannot draw, which makes it a document not worth
   * storing.
   *
   * The bound on the offset is what stops "attached" from meaning "anywhere".
   * A hundred metres from the thing it hangs off is not an offset, and without
   * a limit the field is free storage with a plausible name on it.
   *
   * What this cannot check is a cycle — rules see one document at a time and
   * cannot walk a chain — so the client caps the depth it will follow. A cycle
   * written deliberately costs its author a structure that never draws.
   */
  function isLinked(data) {
    return (!('parent' in data.keys()) && !('local' in data.keys()))
           || (data.parent is string
               && data.parent.size() > 0 && data.parent.size() <= 64
               && data.local.keys().hasOnly(['x', 'y', 'z', 'rotation'])
               && data.local.x is number && data.local.x >= -100 && data.local.x <= 100
               && data.local.y is number && data.local.y >= -100 && data.local.y <= 100
               && data.local.z is number && data.local.z >= -100 && data.local.z <= 100
               && data.local.rotation.x is number && data.local.rotation.y is number
               && data.local.rotation.z is number && data.local.rotation.w is number);
  }

  function isGeoPose(pose) {
    return pose.keys().hasOnly(['position', 'quaternion'])
           && pose.position.lat is number
           && pose.position.lat >= -90 && pose.position.lat <= 90
           && pose.position.lon is number
           && pose.position.lon >= -180 && pose.position.lon <= 180
           && pose.position.h is number
           // Below the Dead Sea or above the stratosphere is a bug, not a place.
           && pose.position.h >= -500 && pose.position.h <= 20000
           && pose.quaternion.x is number && pose.quaternion.y is number
           && pose.quaternion.z is number && pose.quaternion.w is number;
  }
}
